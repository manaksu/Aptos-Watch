          "trackingAdjust": 0,
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "APTOS_36",
          "file": "fonts/Aptos-Display.ttf",
          "characterRegex": "[0-9:]",
          "trackingAdjust": 0,
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "APTOS_22",
          "file": "fonts/Aptos-Display.ttf",
          "characterRegex": "[A-Za-z0-9 ,.]",
          "trackingAdjust": 0,
          "compatibility": "2.7"
        }
      ]
    }
  }
}
