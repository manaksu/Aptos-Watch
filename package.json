          "trackingAdjust": 0,
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "APTOS_MONO_14",
          "file": "fonts/Aptos-Mono.ttf",
          "characterRegex": "[A-Za-z0-9,.:/~% ]",
